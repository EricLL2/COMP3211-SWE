%%{init: {"markdownAutoWrap": false}}%%
classDiagram
    direction TB
    class CursesUI {
        +Terminal term
        +stdscr
        +Theme theme
        +str buffer
        +int choice_index
        +loop() None
    }
    class Terminal {
        +App app
        +stdin
        +stdout
        +Queue queue
        +set dismissed
        -list~Prompt~ _prompts
        +run() None
        +render() None
        +screen() Screen
        +visible_due() list~DueAlarm~
        +ask(prompt, handler, kind, chooser, picker, browser) None
        +apply_accelerator(action: str) None
        +cancel_prompt() None
        +current_chooser() Chooser
        +current_picker() DateTimePicker
        +current_browser() FileBrowser
    }
    class Prompt {
        +str label
        +Callable handler
        +str kind
        +Chooser chooser
        +DateTimePicker picker
        +FileBrowser browser
    }
    class Chooser {
        +str title
        +tuple~Choice~ options
        +int default
        +move(index: int, delta: int) int
        +pick_key(char: str) int
        +value_at(index: int) str
    }
    class DateTimePicker {
        +date day
        +int hour
        +int minute
        +value() str
        +move_day(days: int) None
        +move_month(months: int) None
        +move_time(minutes: int) None
    }
    class FileBrowser {
        +str mode
        +Path cwd
        +list~Entry~ entries
        +move(delta: int) None
        +go_up() None
        +activate() str
    }
    class App {
        +PIM pim
        +str status
        +str status_kind
        +str print_text
        -Criterion _criterion
        -list~PIR~ _result
        -int _selected_id
        +create(type_name: str, fields: dict) PIR
        +modify(fields: dict) PIR
        +delete_selected() bool
        +search(line: str) bool
        +clear_search() None
        +select_row(number: int) None
        +select_id(pir_id: int) None
        +print_selected() str
        +print_all() str
        +save(path: str) bool
        +load(path: str, force: bool) bool
        +due_alarms(now: datetime) list~DueAlarm~
        +current_result() list~PIR~
        +selected() PIR
    }
    class PIM {
        <<model>>
    }
    CursesUI --> Terminal : drives on a TTY
    Terminal "1" o-- "0..*" Prompt : open questions
    Prompt "1" o-- "0..1" Chooser
    Prompt "1" o-- "0..1" DateTimePicker
    Prompt "1" o-- "0..1" FileBrowser
    CursesUI ..> Prompt : operates its widget
    Terminal --> App : calls
    App --> PIM : calls
