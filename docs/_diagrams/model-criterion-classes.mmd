%%{init: {"markdownAutoWrap": false}}%%
classDiagram
    direction TB
    class parse_criterion {
        <<function>>
        +parse_criterion(text: str) Criterion
    }
    class Criterion {
        <<abstract>>
        +matches(pir: PIR) bool
    }
    class TypeIs {
        +str type_name
    }
    class Contains {
        +str field
        +str needle
    }
    class TimeCompare {
        +str field
        +str op
        +datetime instant
    }
    class And {
        +Criterion left
        +Criterion right
    }
    class Or {
        +Criterion left
        +Criterion right
    }
    class Not {
        +Criterion inner
    }
    parse_criterion ..> Criterion : builds
    Criterion <|-- TypeIs
    Criterion <|-- Contains
    Criterion <|-- TimeCompare
    Criterion <|-- And
    Criterion <|-- Or
    Criterion <|-- Not
    And o-- "2" Criterion : children
    Or o-- "2" Criterion : children
    Not o-- "1" Criterion : child
